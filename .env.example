# Copy this file to ".env" (git-ignored) and fill in real values.
# .NET does NOT auto-load .env files — this is just a convenient place to keep
# values before exporting them, or for tools/docker that do read .env.
# PowerShell:  $env:LmStudio__ApiKey="sk-..."
# Bash:        export LmStudio__ApiKey="sk-..."
LmStudio__ApiKey=
LmStudio__BaseUrl=http://127.0.0.1:1234
